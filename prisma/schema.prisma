// NCOM data model.
//
// Every Store is an ecommerce store: there is no landing-page-only mode. A
// Store owns its pages, its theme, and its whole commerce graph, and is
// reachable at its own subdomain.
//
// A page is composed of PageSection rows. Each carries a `type` — a block key
// from modules/sections/registry.ts — plus its own JSON content and design
// config. The block catalogue lives in code rather than in a table, so adding a
// block is a TypeScript module and never a migration, and the palette, the
// inspector, the canvas and the published page are four views of one
// definition.
//
// Draft vs. published: live editing operates on normalized PageSection rows. Publishing
// snapshots the current sections + SEO + theme into an immutable PageVersion.snapshot JSON
// blob; Page.publishedVersionId points at it. The public renderer reads only
// PageVersion.snapshot, never live PageSection rows.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Identity & Tenancy ──────────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  platformRole  PlatformRole   @default(USER)
  isSuspended   Boolean        @default(false)
  // Captured at signup. Drives onboarding and tells us who is actually here —
  // an existing merchant migrating needs a different first-run than someone
  // who has never sold anything.
  signupPurpose SignupPurpose?
  onboardedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts     Account[]
  sessions     Session[]
  memberships  Membership[]
  mediaAssets  MediaAsset[]  @relation("UploadedBy")
  auditLogs    AuditLog[]
  pageVersions PageVersion[]

  verificationCodes EmailVerificationCode[]
  couponsCreated    PlanCoupon[]
  apiKeysCreated    ApiKey[]
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum SignupPurpose {
  START_SELLING
  MOVE_EXISTING_STORE
  BUILD_FOR_CLIENT
  JUST_EXPLORING
}

// Auth.js (NextAuth) v5 Prisma adapter models.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations OrgInvitation[]
  stores      Store[]
  mediaAssets MediaAsset[]

  // Commerce lives here, not on Store. One catalogue, one inventory, one order
  // book, one set of payment/shipping/tax settings — reused by every storefront
  // the organisation runs. A store is a website; this is the business.
  settings         OrganizationSettings?
  products         Product[]
  categories       Category[]
  collections      Collection[]
  customers        Customer[]
  carts            Cart[]
  orders           Order[]
  discounts        Discount[]
  locations        Location[]
  shippingZones    ShippingZone[]
  taxRates         TaxRate[]
  paymentProviders PaymentProviderConfig[]

  // What the organisation buys from NCOM, and what it has used of it.
  subscription      Subscription?
  planOrders        PlanOrder[]
  couponRedemptions PlanCouponRedemption[]
  usageCounters     UsageCounter[]
  customDomains     CustomDomain[]

  // Integration surface: how other systems talk to this organisation's data.
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]

  // Courier automation: who ships the parcels, on what terms, and what the
  // fraud history of the phone numbers ordering them looks like.
  courierConfigs   CourierConfig[]
  courierSettings  CourierSettings?
  courierShipments CourierShipment[]
  fraudChecks      CourierFraudCheck[]
  fraudAccounts    FraudAccount[]
}

// A pending invitation to join an organisation.
//
// Separate from Membership because the invitee may not have an account yet —
// the invite is addressed to an email, and becomes a Membership only when a
// real user accepts it. `tokenHash` is stored rather than the token so a
// leaked database cannot be used to join organisations.
model OrgInvitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole   @default(VIEWER)
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole  @default(OWNER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

enum OrgRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

// ── Stores & Pages ───────────────────────────────────────────────────────

model Store {
  id                String   @id @default(cuid())
  organizationId    String
  name              String
  subdomain         String   @unique
  isSearchIndexable Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// The one stock pool this store sells from.
  ///
  /// An organisation may keep several locations — a shop and a warehouse are
  /// genuinely different places — but a store reads and writes exactly one of
  /// them. Multi-location allocation is a warehousing problem, and modelling it
  /// per store meant every stock question ("can I sell this?") had to first
  /// answer "from where?", which is a question a single-warehouse merchant
  /// should never be asked.
  ///
  /// Null means "the organisation's first active location", resolved at read
  /// time — so a store works before anyone has opened inventory settings.
  inventoryLocationId String?

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryLocation  Location?               @relation("StoreInventory", fields: [inventoryLocationId], references: [id], onDelete: SetNull)
  pages              Page[]
  theme              ThemeSettings?
  integration        StoreIntegrationConfig?
  mediaAssets        MediaAsset[]
  pageViews          PageView[]
  trackingDeliveries TrackingDelivery[]
  // Extra hostnames this store answers on. The subdomain above is always
  // available; these are the tenant's own domains and are quota'd by plan.
  customDomains      CustomDomain[]

  // Attribution only. Carts and orders are owned by the organisation; these
  // record which storefront the sale came through, so a merchant running three
  // landing pages off one catalogue can tell which one is working.
  carts  Cart[]
  orders Order[]
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

model ThemeSettings {
  id              String      @id @default(cuid())
  storeId         String      @unique
  primaryColor    String
  secondaryColor  String
  backgroundColor String
  textColor       String
  headingFont     String
  bodyFont        String
  buttonStyle     ButtonStyle @default(SOLID)
  borderRadius    String
  spacingScale    String
  containerWidth  String
  customCss       String?

  // Brand assets, stored as URLs to match how every section already stores
  // images (hero.imageUrl and friends). EnCDN delivery URLs are lifetime
  // signed, so there is no re-signing step to protect against, and keeping
  // URLs means the render path never has to resolve a media id.
  logoUrl          String?
  logoWidth        Int?    @default(140)
  faviconUrl       String?
  // Extra design controls surfaced in the builder's Design tab.
  headingWeight    String  @default("600")
  bodyScale        String  @default("1")
  sectionSpacing   String  @default("comfortable")
  showStickyHeader Boolean @default(true)

  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

enum ButtonStyle {
  SOLID
  OUTLINE
  GHOST
}

// Where a store's traffic and sales are reported to.
//
// The ids here are used twice over: once by the browser tag this store renders,
// and once by the server when it reports the same events itself. That pairing
// is the whole design — see server/services/trackingService.ts for how the two
// halves are kept from counting the same sale twice.
model StoreIntegrationConfig {
  id               String  @id @default(cuid())
  storeId          String  @unique
  gaMeasurementId  String?
  gtmContainerId   String?
  metaPixelId      String?
  customHeadScript String?

  // ── Server-side tracking credentials ──────────────────────────────────
  //
  // Encrypted at rest (lib/crypto) for the same reason payment keys are: a
  // Conversions API token can post arbitrary events into a merchant's ad
  // account and shape what Meta charges them for, and a GA4 API secret can
  // poison the reports they price their advertising against. Neither is
  // recoverable from a leaked database dump alone.
  //
  // Presence is the switch. A pixel id on its own renders the browser tag as
  // before; a pixel id *and* a token additionally reports from the server, so
  // turning server-side tracking on is one paste and turning it off is one
  // delete. There is no separate enabled flag to drift out of step with the
  // credentials it guards.
  /// Meta Conversions API access token, encrypted.
  metaAccessToken   String?
  /// Meta's Test Events code. Set while a merchant is verifying setup in Events
  /// Manager; events carrying it are routed to the test stream and excluded
  /// from reporting, so it must be cleared before it means anything real.
  metaTestEventCode String?
  /// GA4 Measurement Protocol API secret, encrypted.
  ga4ApiSecret      String?

  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Page {
  id                 String     @id @default(cuid())
  storeId            String
  slug               String
  title              String
  isHome             Boolean    @default(false)
  status             PageStatus @default(DRAFT)
  publishedVersionId String?    @unique
  publishedAt        DateTime?
  previewToken       String     @unique @default(cuid())

  seoTitle       String?
  seoDescription String?
  ogImageMediaId String?
  robotsIndex    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sections         PageSection[]
  versions         PageVersion[] @relation("PageVersions")
  publishedVersion PageVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  ogImage          MediaAsset?   @relation(fields: [ogImageMediaId], references: [id], onDelete: SetNull)
  offers           Offer[]
  checkout         PageCheckout?
  orders           Order[]

  @@unique([storeId, slug])
}

enum PageStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

// ─────────────────────────────────────────────────────────────────────────────
// What a landing page sells
//
// A landing page does not sell variants, it sells OFFERS: "just the one",
// "2-piece combo — ৳1800", "any 3 from this set — ৳2500". That is the shape of
// the market this platform serves, and it is not expressible as a variant plus
// a quantity, because the price of three pieces is whatever the merchant
// negotiated rather than three times the price of one.
//
// Offers hang off the Page rather than the Organization on purpose. The
// catalogue, the inventory and the order book are the business and are shared
// by every storefront; an offer is a *campaign* — this page, this ad, this
// price — and two pages may sell the very same product at two different
// bundle prices without either being wrong.
//
// No price here is ever trusted from the browser. lib/offers/pricing.ts is the
// single rule, and the order route re-derives every figure from these rows and
// the live variant prices. See that module for the arithmetic.
// ─────────────────────────────────────────────────────────────────────────────

enum OfferKind {
  /// An exact set of products and quantities sold together for one price.
  FIXED
  /// A pool the buyer mixes and matches from; the total quantity picks a rung
  /// of the manual price ladder (`tiers`), whatever they chose.
  COLLECTION
  /// A pool the buyer freely picks from, each item at its own price, with an
  /// optional flat discount over the resulting cart.
  ALACARTE
}

enum OfferPricingMode {
  /// The regular total, no discount.
  AUTO
  /// `priceCents` is the total for the whole offer. FIXED offers only.
  FIXED
  /// `discountBps` basis points off the regular total.
  PERCENT
  /// `priceCents` off the regular total.
  AMOUNT
}

model Offer {
  id     String @id @default(cuid())
  pageId String

  /// Stable identity posted by the public order form. Regenerating this
  /// orphans any ad already pointing at the offer, so it is written once.
  key         String
  label       String // "১টি নিন", "ফ্যামিলি প্যাক"
  description String?
  badge       String? // "সবচেয়ে জনপ্রিয়", "৪০% ছাড়"

  kind        OfferKind        @default(FIXED)
  pricingMode OfferPricingMode @default(AUTO)

  /// Minor units. The offer total under FIXED, the money off under AMOUNT.
  priceCents  Int @default(0)
  /// Basis points off the regular total under PERCENT, matching how every
  /// other rate on the platform is stored.
  discountBps Int @default(0)

  /// Strike-through price. 0 falls back to the computed regular total, which
  /// is the honest comparison and the right default.
  compareAtCents Int @default(0)

  /// Piece-count bounds for COLLECTION and ALACARTE. 0 means unbounded; a
  /// COLLECTION is additionally bounded by the rungs its ladder prices.
  minQuantity Int @default(0)
  maxQuantity Int @default(0)

  /// The offer preselected on the page. Exactly one wins; the resolver takes
  /// the first by position if a merchant marks several.
  isDefault Boolean @default(true)
  isActive  Boolean @default(true)
  position  Int     @default(0)

  imageMediaId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page  Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  image MediaAsset? @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  items OfferItem[]
  tiers OfferTier[]

  @@unique([pageId, key])
  @@index([pageId, position])
}

model OfferItem {
  id      String @id @default(cuid())
  offerId String

  productId String
  /// Pin a variant, or leave null to let the buyer choose one on the page.
  /// A single-variant product needs no choice and resolves automatically.
  variantId String?

  /// How many of this line the offer includes. FIXED offers only — in a
  /// COLLECTION or ALACARTE the buyer decides, so this is ignored.
  quantity Int @default(1)
  position Int @default(0)

  offer   Offer           @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([offerId, position])
  @@index([productId])
}

/// One rung of a COLLECTION offer's price ladder: "take this many, pay exactly
/// this". Non-linear by design — three pieces cost what the merchant typed,
/// not three times the price of one.
model OfferTier {
  id      String @id @default(cuid())
  offerId String

  quantity   Int
  priceCents Int

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, quantity])
  @@index([offerId, quantity])
}

// ─────────────────────────────────────────────────────────────────────────────
// Page-level checkout rules
//
// Delivery charges and promotions are set per landing page, not per store. A
// campaign page runs its own economics: the price is already the negotiated
// price, so the organisation's shipping zones and free-shipping thresholds are
// the *default* rather than the law.
// ─────────────────────────────────────────────────────────────────────────────

enum PageShippingMode {
  /// Fall back to the organisation's shipping zones.
  INHERIT
  /// No delivery charge at all.
  FREE
  /// One rate for everyone, wherever they are.
  FLAT
  /// The rates configured on this page, chosen by the buyer.
  ZONES
}

model PageCheckout {
  id     String @id @default(cuid())
  pageId String @unique

  shippingMode  PageShippingMode @default(INHERIT)
  flatRateCents Int              @default(0)
  /// Show the delivery-area picker. Off means everyone is charged the first
  /// rate, which is what a merchant delivering to one city wants.
  askZone       Boolean          @default(true)

  /// Delivery becomes free once either threshold is met. 0 disables that
  /// condition; both set means either one qualifies.
  freeShippingEnabled          Boolean @default(false)
  freeShippingMinSubtotalCents Int     @default(0)
  freeShippingMinQuantity      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page          Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  rates         PageShippingRate[]
  discountRules PageDiscountRule[]
}

/// One delivery area on a page. Free-form rather than a fixed Dhaka/outside
/// enum so a merchant can name their own areas — the defaults are Bangladeshi
/// because the market is, not because the schema demands it.
model PageShippingRate {
  id         String @id @default(cuid())
  checkoutId String

  label      String // "ঢাকার ভিতরে"
  priceCents Int    @default(0)
  position   Int    @default(0)

  checkout PageCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([checkoutId, position])
}

enum PromotionBasis {
  SUBTOTAL
  QUANTITY
}

enum PromotionReward {
  AMOUNT
  PERCENT
}

/// A "spend or buy this much, get this off" rule covering the whole page. The
/// single best-for-the-buyer matching rule applies — they do not stack, because
/// stacking ladders is how a merchant accidentally sells at a loss.
model PageDiscountRule {
  id         String @id @default(cuid())
  checkoutId String

  basis             PromotionBasis @default(SUBTOTAL)
  thresholdCents    Int            @default(0)
  thresholdQuantity Int            @default(0)

  reward           PromotionReward @default(AMOUNT)
  valueCents       Int             @default(0)
  valueBps         Int             @default(0)
  /// Ceiling for a percentage reward. 0 is uncapped.
  maxDiscountCents Int             @default(0)

  label    String?
  position Int     @default(0)

  checkout PageCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([checkoutId, position])
}

// One block on a page.
//
// `type` is a block key from modules/sections/registry.ts — the catalogue lives
// in code, not in a table, so adding a block is a module and no migration.
// `content` is that block's own zod-validated shape and `config` is the
// per-section design overrides; both are JSON because their shape belongs to
// the block, and a section saved before a field existed still parses.
model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  type      String
  order     Int
  content   Json
  config    Json
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
}

model PageVersion {
  id          String    @id @default(cuid())
  pageId      String
  label       String?
  snapshot    Json
  createdById String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  page             Page  @relation("PageVersions", fields: [pageId], references: [id], onDelete: Cascade)
  publishedForPage Page? @relation("PublishedVersion")
  createdBy        User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
}

// ── Media ───────────────────────────────────────────────────────────────

model MediaAsset {
  id             String  @id @default(cuid())
  organizationId String
  storeId        String?
  uploadedById   String?
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  url            String
  width          Int?
  height         Int?
  altText        String?

  // Where the bytes came from, when they were pulled from somewhere else
  // rather than uploaded by a person. This is what makes an import idempotent
  // for images: re-running a catalogue import finds the asset already here
  // instead of re-downloading and re-encoding 370 photos and leaving 370
  // duplicates behind.
  sourceUrl String?

  createdAt DateTime @default(now())

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store               Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  uploadedBy          User?          @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  pagesUsingAsOgImage Page[]
  productImages       ProductImage[]
  offers              Offer[]
  categories          Category[]

  @@index([organizationId])
  @@index([organizationId, sourceUrl])
}

// ── Analytics ──────────────────────────────────────────────────────────

model PageView {
  id          String   @id @default(cuid())
  pageId      String
  storeId     String
  path        String
  referrer    String?
  deviceType  String?
  visitorHash String
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@index([storeId, createdAt])
}

// One attempt-tracked delivery of one conversion to one ad platform.
//
// Only events that are worth money get a row. A purchase reported to Meta or
// GA4 decides what a merchant's ads are optimised for and what they believe
// their return is, so it is queued, retried and auditable — "did the sale
// reach Meta?" has to have an answer. Page views do not get rows: they are
// sent best-effort from the render and a lost one is noise, while a row per
// view per destination would be the largest table in the database within a
// month and would buy nothing.
//
// `dedupeKey` is the platform's own guarantee against double counting, and it
// is the reason this table exists rather than a fire-and-forget call. It is
// derived from the business event — `purchase:<orderId>` — so a retried
// request, a replayed cart, or a second sweep of the queue all collide on the
// same row and the second insert is discarded. The ad platforms' own
// deduplication (Meta's `event_id`, GA4's `transaction_id`) is the second
// line, not the first: those only help when the duplicate reaches them.
model TrackingDelivery {
  id      String @id @default(cuid())
  storeId String

  destination TrackingDestination
  eventName   TrackingEventName

  /// Shared with the browser tag for the same business event, so Meta collapses
  /// the pixel's copy and this one into a single conversion. Identical across
  /// every retry, because a retry is the same event happening once.
  eventId   String
  /// Unique per destination. The insert that loses the race is the duplicate.
  dedupeKey String

  payload Json

  status       TrackingDeliveryStatus @default(PENDING)
  attempts     Int                    @default(0)
  statusCode   Int?
  error        String?
  responseBody String?                @db.Text

  nextAttemptAt DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([destination, dedupeKey])
  // Drives the merchant-facing "last conversion sent" panel.
  @@index([storeId, createdAt])
  // Drives the retry sweep: pending rows whose backoff has elapsed.
  @@index([status, nextAttemptAt])
}

enum TrackingDestination {
  /// Meta Conversions API.
  META_CAPI
  /// Google Analytics 4 Measurement Protocol.
  GA4_MP
}

/// The platform's own names for the events it reports. Each destination
/// translates these into its own vocabulary — PURCHASE is `Purchase` to Meta
/// and `purchase` to GA4 — so neither wire format leaks into the queue.
enum TrackingEventName {
  PAGE_VIEW
  VIEW_CONTENT
  PURCHASE
}

enum TrackingDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// ── Platform admin ────────────────────────────────────────────────────────

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// SAAS: PLANS, ENTITLEMENTS, PLATFORM BILLING
// ═══════════════════════════════════════════════════════════════════════════
//
// What NCOM sells to its own tenants. Do not confuse this with the COMMERCE
// block below, which is what merchants sell to their shoppers. Two rules keep
// them from bleeding into each other: nothing here is ever scoped to a Store,
// and nothing there is ever priced in the platform's own currency.
//
// Everything is data, not code. A platform admin edits plans, quotas, feature
// gates, add-ons and coupons from /admin and the change takes effect on the
// next request, because entitlements are resolved from these rows rather than
// from a constant in the bundle. Hard-coding the price table would have meant
// a deploy for every pricing experiment.
//
// Money: minor units (paisa for BDT) as Int, and percentages as basis points —
// the same convention as the COMMERCE block. See lib/money.ts.
//
// Quotas: `null` means unlimited and `0` means none allowed. That distinction
// is load-bearing, not stylistic: Free permits 0 custom domains while
// Enterprise permits unlimited, and the two would collapse into the same value
// if absence were spelled 0.

model Plan {
  id       String  @id @default(cuid())
  code     String  @unique // stable machine name: FREE, STARTER, BUSINESS, ENTERPRISE
  name     String
  tagline  String?
  position Int     @default(0)

  isActive           Boolean @default(true) // false hides it and blocks new subscriptions
  isPublic           Boolean @default(true) // listed on the public pricing page
  // Where new signups land. Exactly one plan carries this; planAdminService
  // clears the flag on every other plan when it is set.
  isDefault          Boolean @default(false)
  // Priced per deal, so the UI shows "Contact sales" rather than a checkout
  // button and the amount is agreed off-platform.
  isContactSalesOnly Boolean @default(false)

  currencyCode      String @default("BDT")
  monthlyPriceCents Int    @default(0)
  // null = monthly only. The seeded annual prices are 10x monthly (two months
  // free) but nothing enforces that ratio — admins set both independently.
  annualPriceCents  Int?
  trialDays         Int    @default(0)

  // ── Quotas: null = unlimited ──
  maxPages         Int?
  maxStores        Int?
  maxCustomDomains Int? @default(0)
  maxTeamMembers   Int? @default(1)
  storageMb        Int?
  monthlyTrafficMb Int?
  // Advisory, not enforced by default — the price sheet calls this
  // "recommended monthly visitors", and throttling a site for being popular
  // when its bandwidth is still within budget would be a support incident.
  // `enforceVisitorCap` opts a plan into treating it as a hard ceiling.
  monthlyVisitors  Int?

  // ── Feature gates ──
  // Tri-state on purpose: the price sheet distinguishes "—" (not available),
  // "Optional" (available by buying the add-on) and "Included". Collapsing
  // that to a boolean would lose the only thing that makes an add-on sellable.
  premiumTemplates          FeatureAvailability @default(UNAVAILABLE)
  advancedSeo               FeatureAvailability @default(UNAVAILABLE)
  googleAnalytics           FeatureAvailability @default(UNAVAILABLE)
  metaPixel                 FeatureAvailability @default(UNAVAILABLE)
  googleTagManager          FeatureAvailability @default(UNAVAILABLE)
  aiContentAssistant        FeatureAvailability @default(UNAVAILABLE)
  advancedAnalytics         FeatureAvailability @default(UNAVAILABLE)
  whiteLabel                FeatureAvailability @default(UNAVAILABLE)
  dedicatedAccountManager   FeatureAvailability @default(UNAVAILABLE)
  dedicatedTechnicalSupport FeatureAvailability @default(UNAVAILABLE)

  // Included on every tier today. Still modelled rather than assumed, so a
  // future tier can drop one without a schema change.
  ncomSubdomain    Boolean @default(true)
  dragDropBuilder  Boolean @default(true)
  responsiveEditor Boolean @default(true)
  basicTemplates   Boolean @default(true)
  basicSeo         Boolean @default(true)
  sslCertificate   Boolean @default(true)

  supportTier SupportTier @default(COMMUNITY)

  // The asterisk on "Unlimited*". Rendered as a footnote beside an unlimited
  // quota so the fair-use terms travel with the number they qualify.
  fairUseNote String?

  enforceTrafficCap Boolean @default(true)
  enforceVisitorCap Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  planOrders    PlanOrder[]
  coupons       PlanCouponPlan[]
  addons        AddonPlan[]

  @@index([isActive, position])
}

enum FeatureAvailability {
  UNAVAILABLE
  ADDON // "Optional" on the price sheet: usable only once the add-on is bought
  LIMITED // available with caveats (Business's dedicated technical support)
  INCLUDED
}

enum SupportTier {
  COMMUNITY
  STANDARD
  PRIORITY
  DEDICATED
}

// A quota bump or feature unlock bought on top of a plan.
model Addon {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  position    Int     @default(0)
  isActive    Boolean @default(true)

  currencyCode      String @default("BDT")
  monthlyPriceCents Int    @default(0)
  annualPriceCents  Int?

  // What ONE unit grants, added on top of the plan's quota. An add-on that
  // unlocks a capability instead of raising a number sets `grantsFeature`.
  grantsCustomDomains Int           @default(0)
  grantsStorageMb     Int           @default(0)
  grantsTrafficMb     Int           @default(0)
  grantsTeamMembers   Int           @default(0)
  grantsFeature       AddonFeature?

  // null = stackable without limit (extra storage); 1 = a switch (AI assistant)
  maxQuantity Int?

  availableOnAllPlans Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans              AddonPlan[]
  subscriptionAddons SubscriptionAddon[]

  @@index([isActive, position])
}

enum AddonFeature {
  AI_CONTENT_ASSISTANT
  ADVANCED_ANALYTICS
  PREMIUM_TEMPLATES
  WHITE_LABEL
}

model AddonPlan {
  addonId String
  planId  String

  addon Addon @relation(fields: [addonId], references: [id], onDelete: Cascade)
  plan  Plan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([addonId, planId])
}

model Subscription {
  id             String @id @default(cuid())
  // One live subscription per organisation. A plan change mutates this row and
  // records a PlanOrder for the history, rather than accumulating rows that
  // every entitlement read would then have to disambiguate.
  organizationId String @unique
  planId         String

  interval SubscriptionInterval @default(MONTHLY)
  status   SubscriptionStatus   @default(ACTIVE)

  startedAt          DateTime  @default(now())
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime? // null on a free plan that never renews
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  endedAt            DateTime?
  trialEndsAt        DateTime?

  // Snapshot of the price actually agreed, so raising a plan's price does not
  // silently re-price everyone already on it.
  currencyCode   String @default("BDT")
  unitPriceCents Int    @default(0)
  discountCents  Int    @default(0)

  couponId               String?
  couponAppliedAt        DateTime?
  // Renewals left on a REPEATING coupon. Decremented per renewal; 0 means the
  // discount has run out and the next period bills at list price.
  couponPeriodsRemaining Int?

  // Per-organisation quota overrides: an Enterprise deal, a migration, or
  // support goodwill. null = inherit the plan. Applied on top of the plan and
  // before add-ons.
  overrideMaxPages         Int?
  overrideMaxStores        Int?
  overrideMaxCustomDomains Int?
  overrideMaxTeamMembers   Int?
  overrideStorageMb        Int?
  overrideMonthlyTrafficMb Int?
  // Escape hatch for a tenant who must not be blocked mid-incident or
  // mid-migration. Bypasses quota checks only — feature gates still apply.
  quotaEnforcementDisabled Boolean @default(false)

  adminNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan                   @relation(fields: [planId], references: [id])
  coupon       PlanCoupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  addons       SubscriptionAddon[]
  orders       PlanOrder[]
  redemptions  PlanCouponRedemption[]

  @@index([status])
  @@index([planId])
  @@index([currentPeriodEnd])
}

enum SubscriptionInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PENDING // checkout finished but access not granted yet (awaiting payment)
  PAST_DUE // reserved for when a gateway exists and a charge fails
  CANCELED
  EXPIRED
}

model SubscriptionAddon {
  id             String   @id @default(cuid())
  subscriptionId String
  addonId        String
  quantity       Int      @default(1)
  unitPriceCents Int      @default(0) // snapshot, same reason as Subscription
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addon        Addon        @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, addonId])
}

// One attempt to start or change a subscription.
//
// A full order record even though nothing is charged today: every tenant is
// being onboarded with a 100%-off coupon, so checkout reaches ৳0 and activates
// immediately. This row is what a payment gateway will later attach to —
// `provider`, `providerReference` and `paidAt` are that seam, and the status
// machine already separates "nothing to pay" (AUTO_ACTIVATED) from "waiting on
// money" (AWAITING_PAYMENT). No gateway has been chosen, so deliberately no
// provider-specific column exists yet.
model PlanOrder {
  id             String  @id @default(cuid())
  organizationId String
  subscriptionId String?
  planId         String

  interval SubscriptionInterval

  currencyCode  String @default("BDT")
  subtotalCents Int
  discountCents Int    @default(0)
  totalCents    Int

  couponId   String?
  // The code as typed, kept even if the coupon row is later deleted — an
  // order must always be able to explain its own discount.
  couponCode String?

  status PlanOrderStatus @default(AWAITING_PAYMENT)

  // Snapshot of what was bought: plan name and price plus one line per add-on.
  lineItems Json

  provider          String? // set once a gateway is wired
  providerReference String?
  paidAt            DateTime?
  activatedAt       DateTime?
  canceledAt        DateTime?
  failureReason     String?   @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan         Plan                  @relation(fields: [planId], references: [id])
  coupon       PlanCoupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  redemption   PlanCouponRedemption?

  @@index([organizationId, createdAt])
  @@index([status])
}

enum PlanOrderStatus {
  AWAITING_PAYMENT // total > 0 and no gateway is available yet
  AUTO_ACTIVATED // total was 0 (free plan or full-discount coupon) — access granted
  PAID
  ACTIVATED
  CANCELED
  FAILED
}

// Platform-level promo code. Separate from the storefront `Discount` model,
// which is a merchant's own promotion on their own catalogue — these two must
// never share a table, a code namespace, or a currency.
model PlanCoupon {
  id          String  @id @default(cuid())
  code        String  @unique // stored upper-cased; lookups upper-case the input
  name        String?
  description String?
  isActive    Boolean @default(true)

  discountType  PlanDiscountType
  // Read according to `discountType`; the rest stay null. Separate columns
  // rather than one polymorphic `value` so a percentage can never be read as
  // an amount in paisa.
  percentageBps Int? // PERCENTAGE — 10000 = 100% off
  amountCents   Int? // FIXED_AMOUNT / OVERRIDE_PRICE
  freeTrialDays Int? // FREE_TRIAL_DAYS
  currencyCode  String           @default("BDT")

  // How long the discount survives renewals.
  duration       CouponDuration @default(FOREVER)
  durationMonths Int? // REPEATING only

  // ── Eligibility rules. Every one is ANDed. ──
  appliesToAllPlans     Boolean                @default(true)
  appliesToAddons       Boolean                @default(false)
  allowedIntervals      SubscriptionInterval[] @default([]) // empty = any
  newOrganizationsOnly  Boolean                @default(false) // never had a subscription
  firstPurchaseOnly     Boolean                @default(false) // no prior PlanOrder
  existingCustomersOnly Boolean                @default(false) // signed up before the cutoff
  existingBeforeAt      DateTime? // the cutoff for the rule above
  minSubtotalCents      Int?
  minTermMonths         Int?
  requiresVerifiedEmail Boolean                @default(false)

  restrictedToOrganizationIds String[] @default([])
  restrictedToEmails          String[] @default([])
  restrictedToEmailDomain     String?

  // ── Redemption limits ──
  maxRedemptions       Int? // across the whole platform
  maxRedemptionsPerOrg Int? @default(1)
  redeemedCount        Int  @default(0)

  // ── Window ──
  startsAt DateTime?
  endsAt   DateTime?

  // Whether it may combine with another coupon on the same order.
  isStackable Boolean @default(false)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy     User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  plans         PlanCouponPlan[]
  redemptions   PlanCouponRedemption[]
  subscriptions Subscription[]
  planOrders    PlanOrder[]

  @@index([isActive, endsAt])
}

enum PlanDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE // 100% off for the coupon's duration — the launch/onboarding case
  OVERRIDE_PRICE // charge exactly `amountCents`, whatever the plan costs
  FREE_TRIAL_DAYS // no discount; extends the trial instead
}

enum CouponDuration {
  ONCE // the first period only
  REPEATING // `durationMonths` periods
  FOREVER // every renewal for the life of the subscription
}

model PlanCouponPlan {
  couponId String
  planId   String

  coupon PlanCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  plan   Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([couponId, planId])
}

model PlanCouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  organizationId String
  subscriptionId String?
  planOrderId    String?  @unique
  discountCents  Int      @default(0)
  redeemedAt     DateTime @default(now())

  coupon       PlanCoupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planOrder    PlanOrder?    @relation(fields: [planOrderId], references: [id], onDelete: SetNull)

  @@index([couponId, organizationId])
}

// ── Usage metering ────────────────────────────────────────────────────────

model UsageCounter {
  id             String      @id @default(cuid())
  organizationId String
  metric         UsageMetric
  // "2026-08" for metrics that reset monthly, "current" for stock metrics like
  // bytes stored. One text column rather than a pair of nullable dates keeps
  // the unique constraint that makes the increment a single atomic upsert.
  period         String
  // Bytes overflow a 32-bit Int at 2.1GB and the smallest paid tier already
  // allows 100GB of traffic. Always mapped to Number at the service boundary —
  // BigInt is not JSON-serialisable and would break any client component it
  // reached.
  value          BigInt      @default(0)
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, period])
  @@index([metric, period])
}

enum UsageMetric {
  STORAGE_BYTES
  TRAFFIC_BYTES
  VISITORS
  PAGE_VIEWS
  AI_GENERATIONS
}

// ── Custom domains ────────────────────────────────────────────────────────

// A hostname a tenant owns, pointed at one of their stores.
//
// Its own table rather than a column on Store because the quota is "N custom
// domains per organisation" and a single site legitimately answers on more
// than one name (apex plus www, or a campaign domain).
model CustomDomain {
  id             String @id @default(cuid())
  organizationId String
  storeId        String
  hostname       String @unique // lower-cased, no scheme, no trailing dot

  // The name canonical links and emails use, when several point at one store.
  isPrimary  Boolean          @default(false)
  status     DomainStatus     @default(PENDING)
  // Apex domains cannot legally hold a CNAME, so the record the tenant is
  // told to create differs by domain shape.
  recordType DomainRecordType @default(CNAME)

  // Proof of control, checked before we answer for the name: a TXT record at
  // _ncom-challenge.<hostname> carrying this value. Random per domain, so one
  // tenant cannot pre-verify a hostname they do not own and then have it
  // handed to them when the real owner adds it.
  verificationToken String

  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  lastError     String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([storeId])
  @@index([status])
}

enum DomainRecordType {
  CNAME
  A
}

// ── Outbound email ────────────────────────────────────────────────────────

// SMTP credentials, one row per purpose.
//
// Per-purpose rather than one global server so a platform can send OTPs
// through a transactional provider and newsletters through a bulk one without
// either one's sending reputation touching the other. DEFAULT is the fallback
// for any purpose with no row of its own.
model EmailSmtpConfig {
  id        String       @id @default(cuid())
  purpose   EmailPurpose @unique
  label     String?
  // Off means "do not send this category at all" — the send is recorded as
  // SKIPPED rather than failing the surrounding operation.
  isEnabled Boolean      @default(true)

  host              String
  port              Int            @default(587)
  encryption        SmtpEncryption @default(STARTTLS)
  username          String
  // AES-256-GCM via lib/crypto.ts. Never selected into anything that reaches
  // the client: the admin UI shows a mask and only writes on change.
  passwordEncrypted String?        @db.Text

  fromName     String
  fromEmail    String
  replyToEmail String?

  // Written by the admin "send test" button so a misconfigured server is
  // visible in the UI instead of only in the logs.
  lastTestAt    DateTime?
  lastTestOk    Boolean?
  lastTestError String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EmailPurpose {
  DEFAULT
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TEAM_INVITATION
  BILLING
  DOMAIN_ALERT
  USAGE_ALERT
  ORDER_RECEIPT
  MARKETING
  SYSTEM_ALERT
}

enum SmtpEncryption {
  NONE
  STARTTLS
  SSL_TLS
}

model EmailLog {
  id        String       @id @default(cuid())
  purpose   EmailPurpose
  toEmail   String
  subject   String
  status    EmailStatus
  error     String?      @db.Text
  smtpHost  String?
  // Never the body, and never the OTP itself: this table is read by support,
  // and a log that lets you read the code you were sent is a code you did not
  // need email access to receive.
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@index([toEmail])
  @@index([purpose, status])
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED // no SMTP configured, or the purpose is disabled
}

// A one-time code emailed to prove control of an address.
model EmailVerificationCode {
  id         String     @id @default(cuid())
  userId     String?
  email      String
  purpose    OtpPurpose @default(EMAIL_VERIFICATION)
  // Only the hash is stored, for the same reason OrgInvitation stores
  // tokenHash: a leaked database must not let anyone complete a verification.
  codeHash   String
  // A code dies after a few wrong guesses, so a 6-digit secret cannot be
  // brute-forced inside its lifetime — 10 minutes is otherwise plenty of time
  // to walk the whole keyspace.
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([expiresAt])
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_CHALLENGE
}

// ═══════════════════════════════════════════════════════════════════════════
// COMMERCE
// ═══════════════════════════════════════════════════════════════════════════
//
// Scoping: every commerce row hangs off a Store, never off an Organization
// directly. An org can run several stores and a
// product in one must never be reachable from another, so every tenant query
// filters on storeId and every service call goes through requireOrgAccess
// on the store's owning org first.
//
// Money: all amounts are Int in the currency's minor unit (cents, paisa) —
// never Float, never Decimal-as-string. The currency code lives on the owning
// aggregate (StoreSettings.currencyCode, Order.currencyCode) rather than
// beside each amount, which makes it structurally impossible for one order to
// mix currencies. Percentages are basis points (Int, 1/100th of a percent) for
// the same reason. See lib/money.ts.
//
// Snapshots: Order and OrderLine copy the title, variant title, SKU, price and
// tax that applied at purchase time. Editing or deleting a product later must
// never change what an existing order says it sold. This is the same rule
// PageVersion.snapshot follows on the CMS side, for the same reason — except
// here it is also a legal/accounting requirement, so order rows are treated as
// append-only: corrections create Refund/Transaction rows, they never UPDATE
// the original amounts.

// ── Store configuration ──────────────────────────────────────────────────

model OrganizationSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  currencyCode String     @default("USD") // ISO 4217
  weightUnit   WeightUnit @default(KILOGRAM)

  // Set the first time a human explicitly saves the store's currency.
  //
  // The default is a guess, and prices are stored as bare minor units, so a
  // merchant pushing taka into a workspace still sitting on USD imports ৳1,290
  // as $1,290.00 with every call reporting success. Nothing in the numbers can
  // detect that afterwards — the only moment it is knowable is now, so this
  // records whether anyone has ever actually chosen.
  currencyConfiguredAt DateTime?

  // When true, catalog prices are treated as tax-inclusive: tax is backed out
  // of the line total for display/reporting rather than added on top. This
  // changes every price calculation in the store, so it is deliberately not
  // editable once the store has orders.
  pricesIncludeTax        Boolean @default(false)
  taxesIncludedInShipping Boolean @default(false)

  // Storefront behaviour.
  customerAccountsEnabled   Boolean @default(true)
  requiresCustomerAccount   Boolean @default(false)
  allowOutOfStockPurchase   Boolean @default(false)
  abandonedCartAfterMinutes Int     @default(60)

  // Order identity. Orders are numbered per store, not globally, so a store's
  // first order is #1001 and stays stable regardless of platform-wide volume.
  orderNumberPrefix String @default("#")
  orderNumberSuffix String @default("")
  nextOrderNumber   Int    @default(1001)

  // Contact / legal shown on the storefront and on receipts.
  supportEmail    String?
  supportPhone    String?
  businessName    String?
  businessAddress Json?

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum WeightUnit {
  GRAM
  KILOGRAM
  OUNCE
  POUND
}

// ── Catalog ──────────────────────────────────────────────────────────────

model Product {
  id             String @id @default(cuid())
  organizationId String

  title       String
  handle      String // URL slug, unique per store
  description String?       @db.Text
  status      ProductStatus @default(DRAFT)
  productType String?
  vendor      String?
  tags        String[]      @default([])

  // Where the product sits in the merchandising tree. Nullable because a
  // catalogue is usable before anyone has designed its taxonomy, and because
  // deleting a category must not delete the products filed under it.
  categoryId String?

  // Set by an integration that owns this row upstream. `externalId` is the id
  // in the merchant's own system, and it is what makes an import idempotent:
  // re-importing the same catalogue updates rows instead of duplicating them.
  externalId     String?
  externalSource String?

  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options      ProductOption[]
  variants     ProductVariant[]
  images       ProductImage[]
  collections  CollectionProduct[]
  orderLines   OrderLine[]
  offerItems   OfferItem[]

  @@unique([organizationId, handle])
  // An upstream id is unique per organisation, which is what lets an importer
  // upsert on it without a lookup table.
  @@unique([organizationId, externalId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, categoryId])
}

// ── Categories ───────────────────────────────────────────────────────────

// The merchandising tree: category → subcategory → child category.
//
// Depth is capped at three levels (`level` 0, 1, 2) and enforced in
// categoryService, not by the database. The cap is a product decision rather
// than a technical one — an unbounded tree is easy to store and miserable to
// navigate, and every storefront nav, breadcrumb and filter here assumes it can
// render the whole tree at once.
//
// `level` is denormalized from the parent chain so "list the top-level
// categories" is one indexed read rather than a recursive walk, and so a
// mis-parented row is detectable. It is only ever written by the service.
model Category {
  id             String  @id @default(cuid())
  organizationId String
  parentId       String?

  name        String
  handle      String // URL slug, unique per organisation
  description String? @db.Text

  // Short uppercase code (e.g. "DRS") used to build SKUs and read-friendly
  // exports. Mirrors what the merchant's existing system usually already has.
  code String?

  imageMediaId String?

  level      Int     @default(0)
  position   Int     @default(0)
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  seoTitle       String?
  seoDescription String?

  externalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Deleting a parent orphans its children rather than cascading: losing a
  // whole department because someone removed its top node is not recoverable,
  // and the service re-parents children explicitly instead.
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  image    MediaAsset? @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  products Product[]

  @@unique([organizationId, handle])
  @@unique([organizationId, externalId])
  @@index([organizationId, parentId, position])
  @@index([organizationId, level])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// A product's variant axes ("Size", "Color"). Capped at 3 by convention to
// match variant.option1/2/3 below.
model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String
  position  Int
  values    String[] @default([])

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
}

// option1/2/3 are denormalized rather than a variant↔optionValue join table.
// It caps variants at 3 axes, but it makes the hot storefront query (find the
// variant for a chosen combination) a single indexed lookup instead of a
// relational intersection.
model ProductVariant {
  id        String @id @default(cuid())
  productId String

  title    String // "Small / Red", derived from the option values
  sku      String?
  barcode  String?
  position Int     @default(1)

  option1 String?
  option2 String?
  option3 String?

  priceCents          Int
  compareAtPriceCents Int? // shown struck through when higher than priceCents
  costCents           Int? // for margin reporting; never exposed to the storefront

  // Tax
  isTaxable Boolean @default(true)
  taxCode   String?

  // Inventory. `inventoryTracked = false` means infinite stock (services,
  // digital goods). When tracked, availability is the sum of InventoryLevel
  // rows across locations, and `inventoryPolicy` decides what happens at zero.
  inventoryTracked Boolean         @default(true)
  inventoryPolicy  InventoryPolicy @default(DENY)

  // Shipping
  requiresShipping Boolean @default(true)
  weightGrams      Int     @default(0)

  imageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  image           ProductImage?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  inventoryLevels InventoryLevel[]
  cartLines       CartLine[]
  orderLines      OrderLine[]
  offerItems      OfferItem[]

  @@unique([productId, option1, option2, option3])
  @@index([productId, position])
  @@index([sku])
}

enum InventoryPolicy {
  DENY // stop selling at zero
  CONTINUE // allow overselling / backorder
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  mediaId   String
  altText   String?
  position  Int     @default(0)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  media    MediaAsset       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@index([productId, position])
}

// ── Collections ──────────────────────────────────────────────────────────

model Collection {
  id             String @id @default(cuid())
  organizationId String

  title        String
  handle       String
  description  String? @db.Text
  imageMediaId String?

  // MANUAL collections are ordered by CollectionProduct.position; AUTOMATED
  // ones are computed from `rules` at query time (and cached), so their
  // CollectionProduct rows are not authoritative and are not written.
  type       CollectionType @default(MANUAL)
  rules      Json? // CollectionRule[] — see lib/validation/collection.ts
  rulesMatch RuleMatch      @default(ALL)
  sortOrder  CollectionSort @default(MANUAL)

  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     CollectionProduct[]

  @@unique([organizationId, handle])
  @@index([organizationId])
}

enum CollectionType {
  MANUAL
  AUTOMATED
}

enum RuleMatch {
  ALL
  ANY
}

enum CollectionSort {
  MANUAL
  BEST_SELLING
  TITLE_ASC
  TITLE_DESC
  PRICE_ASC
  PRICE_DESC
  CREATED_ASC
  CREATED_DESC
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId, position])
}

// ── Inventory ────────────────────────────────────────────────────────────

model Location {
  id             String @id @default(cuid())
  organizationId String

  name                 String
  address              Json?
  isActive             Boolean @default(true)
  fulfillsOnlineOrders Boolean @default(true)

  createdAt DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  levels       InventoryLevel[]
  stores       Store[]          @relation("StoreInventory")

  @@index([organizationId])
}

model InventoryLevel {
  id         String @id @default(cuid())
  locationId String
  variantId  String

  // `available` is what can still be sold. `committed` is reserved by orders
  // that are placed but not yet fulfilled — it is tracked separately so the
  // storefront never sells stock that is already promised to someone else.
  available Int @default(0)
  committed Int @default(0)

  updatedAt DateTime @updatedAt

  location Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([locationId, variantId])
  @@index([variantId])
}

// Append-only ledger of every stock movement. Reconstructing how a variant
// reached its current count is the first thing anyone asks during an inventory
// dispute, and it cannot be recovered from InventoryLevel alone.
model InventoryAdjustment {
  id         String @id @default(cuid())
  locationId String
  variantId  String

  delta       Int
  reason      InventoryReason
  referenceId String? // order id, fulfillment id, manual adjustment note id
  note        String?
  actorUserId String?
  createdAt   DateTime        @default(now())

  @@index([variantId, createdAt])
  @@index([locationId, createdAt])
}

enum InventoryReason {
  MANUAL
  ORDER_PLACED
  ORDER_CANCELLED
  FULFILLED
  RESTOCK
  REFUND
  RECEIVED
  DAMAGED
  CORRECTION
}

// ── Customers ────────────────────────────────────────────────────────────

// Storefront customers are deliberately NOT platform Users. A person who buys
// from a tenant's store has no account on NCOM itself, must never appear in an
// org's member list, and their credentials live in a different trust domain.
// The two tables must never be merged.
model Customer {
  id             String @id @default(cuid())
  organizationId String

  // Optional because a cash-on-delivery storefront identifies buyers by phone
  // number, not email. Exactly one of email/phone is guaranteed present by the
  // checkout layer, which is the only place customers are created.
  email           String?
  firstName       String?
  lastName        String?
  phone           String?
  passwordHash    String? // null for guest checkouts that were never converted
  emailVerifiedAt DateTime?

  acceptsMarketing Boolean   @default(false)
  marketingOptInAt DateTime?

  note String?
  tags String[] @default([])

  // Denormalized lifetime stats, recomputed on order transitions. Kept on the
  // row because "customers sorted by spend" is a hot admin query that would
  // otherwise aggregate the whole order table per page load.
  ordersCount     Int @default(0)
  totalSpentCents Int @default(0)

  lastOrderAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addresses    CustomerAddress[]
  carts        Cart[]
  orders       Order[]
  sessions     CustomerSession[]

  @@unique([organizationId, email])
  // Not unique: a household sharing one number is normal in COD markets, and a
  // unique constraint there would reject the second person's order outright.
  @@index([organizationId, phone])
  @@index([organizationId, createdAt])
}

model CustomerAddress {
  id         String @id @default(cuid())
  customerId String

  firstName    String?
  lastName     String?
  company      String?
  address1     String
  address2     String?
  city         String
  provinceCode String?
  countryCode  String // ISO 3166-1 alpha-2
  postalCode   String?
  phone        String?
  isDefault    Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ── Cart ─────────────────────────────────────────────────────────────────

model Cart {
  id             String  @id @default(cuid())
  organizationId String
  /// Which storefront this cart was started on. Attribution only — nulled if
  /// the store is deleted, because the cart and any order belong to the
  /// organisation and must outlive the site that produced them.
  storeId        String?

  // Anonymous carts are addressed by an unguessable token held in a cookie on
  // the storefront domain; `customerId` is attached on login and survives it.
  token      String  @unique @default(cuid())
  customerId String?

  currencyCode String
  note         String?
  attributes   Json? // free-form line-item/cart properties set by the theme

  discountCode String?

  // Checkout progress. A cart becomes an Order exactly once; `completedAt`
  // plus a unique constraint on Order.cartId is what makes a double-submitted
  // checkout idempotent instead of charging twice.
  email           String?
  phone           String?
  shippingAddress Json?
  billingAddress  Json?
  shippingRateId  String?

  completedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines        CartLine[]
  order        Order?

  @@index([organizationId, updatedAt])
  @@index([customerId])
}

model CartLine {
  id     String @id @default(cuid())
  cartId String

  variantId String
  quantity  Int

  // Price is re-read from the variant on every cart render rather than trusted
  // from here — this column only records what the shopper was last shown, so
  // the storefront can tell them "the price changed" instead of silently
  // charging a different amount.
  unitPriceCents Int
  properties     Json? // engraving text, gift note, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ── Orders ───────────────────────────────────────────────────────────────

model Order {
  id                String  @id @default(cuid())
  organizationId    String
  /// Which storefront the order came through. Attribution only — nulled if the
  /// store is deleted, because an order is a financial record of the
  /// organisation and must never disappear with a website.
  storeId           String?
  /// Which landing page, and which offer on it, produced this order. A store
  /// may run a dozen campaign pages against one catalogue, and "which ad paid
  /// for this" is the question a merchant asks of every order — so it is
  /// recorded here rather than inferred from the cart later.
  ///
  /// The label and prices are copied rather than joined: an offer is edited
  /// constantly while a campaign runs, and an order must keep reporting what it
  /// was actually sold at, not what the offer says today. `pageId` nulls if the
  /// page is deleted for the same reason `storeId` does.
  pageId            String?
  offerKey          String?
  offerLabel        String?
  /// What the offer charged for goods, and what those goods list for, both at
  /// the moment of sale. The difference is the campaign discount.
  offerPriceCents   Int?
  offerRegularCents Int?

  // Human-facing number ("#1001"), unique per organisation. `cartId` is unique so a
  // cart can convert to at most one order — the idempotency key for checkout.
  orderNumber String
  cartId      String? @unique

  customerId String?
  // A cash-on-delivery order is placed with a phone number and an address; an
  // email is frequently not collected at all. The checkout layer guarantees at
  // least one contact method, so an order is never unreachable.
  email      String?
  phone      String?

  currencyCode String

  // Monetary breakdown, all in minor units. These are computed once at
  // checkout from the line items and never recalculated — a later price or tax
  // change must not retroactively alter a placed order.
  subtotalCents      Int
  discountTotalCents Int @default(0)
  shippingTotalCents Int @default(0)
  taxTotalCents      Int @default(0)
  totalCents         Int
  // Running totals maintained by Transaction/Refund rows.
  paidTotalCents     Int @default(0)
  refundedTotalCents Int @default(0)

  financialStatus FinancialStatus @default(PENDING)

  /// When the goods stopped being reserved and started being gone.
  ///
  /// Stock leaves on the courier's pickup, not on a merchant pressing a button,
  /// so there is nothing to record but the moment it happened. It is a
  /// timestamp rather than a status because its only job is to make the
  /// consumption idempotent — a parcel emits several pickup-ish events and the
  /// stock must move once.
  stockConsumedAt DateTime?
  /// Set when a refused parcel's goods went back on the shelf, for the same
  /// idempotency reason. Distinct from `stockConsumedAt` being cleared, because
  /// an order that shipped and came back is not an order that never shipped.
  stockRestoredAt DateTime?

  /// What has been handed back, in money. Returns in a cash-on-delivery market
  /// are usually not refunds — the customer refused at the door and no money
  /// ever moved — so this is tracked separately from `refundedTotalCents`,
  /// which means "money we sent back".
  returnedAmountCents  Int     @default(0)
  /// Whether the merchant waived delivery on the returned portion. A judgement
  /// call made per return and recorded because it changes what the customer owes.
  deliveryChargeWaived Boolean @default(false)

  /// Where the order sits in the courier pipeline, which is a different
  /// question from whether it is paid or how much of it has shipped.
  /// `fulfillmentStatus` answers "how many units left the building";
  /// this answers "is a human still deciding, is a courier holding it, did it
  /// arrive". A cash-on-delivery market needs both: an order can be
  /// UNFULFILLED and FRAUD_REVIEW at once, and the merchant acts on the second.
  workflowState     OrderWorkflowState @default(PENDING)
  workflowUpdatedAt DateTime           @default(now())

  /// Fraud screening result, snapshotted at the moment it was taken.
  ///
  /// Copied onto the order rather than joined to CourierFraudCheck for the same
  /// reason line titles are copied: the cached lookup for a phone number keeps
  /// moving as that customer orders elsewhere, and an order must keep reporting
  /// the numbers the decision was actually made on. A dispute six months later
  /// asks "what did you know when you shipped it", not "what is true today".
  fraudVerdict        FraudVerdict?
  fraudCheckedAt      DateTime?
  fraudDelivered      Int?
  fraudCancelled      Int?
  fraudReports        Int?
  /// Delivery success rate in basis points (7000 = 70.00%), so the stored value
  /// is exact and comparable against the merchant's threshold without floats.
  fraudSuccessRateBps Int?
  /// Why the order was held or released, in the merchant's language.
  fraudReason         String?

  /// Who released or refused a held order, and when. Null on anything that was
  /// never held.
  reviewedByUserId String?
  reviewedAt       DateTime?

  shippingAddress     Json?
  billingAddress      Json?
  // Denormalized from shippingAddress purely so tax/shipping reporting can
  // group by country without unpacking JSON on every row.
  shippingCountryCode String?

  shippingMethodTitle String?
  discountCode        String?

  note          String?
  tags          String[] @default([])
  // Marketing attribution captured at checkout.
  landingSite   String?
  referringSite String?

  cancelledAt  DateTime?
  cancelReason CancelReason?
  closedAt     DateTime?
  processedAt  DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  page         Page?             @relation(fields: [pageId], references: [id], onDelete: SetNull)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cart         Cart?             @relation(fields: [cartId], references: [id], onDelete: SetNull)
  lines        OrderLine[]
  transactions Transaction[]
  refunds      Refund[]
  returns      OrderReturn[]
  events       OrderEvent[]
  shipments    CourierShipment[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, createdAt])
  @@index([organizationId, financialStatus])
  // Drives the review queue and the auto-dispatch sweep, both of which read
  // "every order in this state for this organisation, newest first".
  @@index([organizationId, workflowState, createdAt])
  @@index([customerId])
  @@index([pageId])
}

/// The courier pipeline, from placement to doorstep.
///
/// Deliberately linear in the happy path — PENDING, PROCESSING, DISPATCHED,
/// IN_TRANSIT, DELIVERED — because that is the sequence a merchant reads down a
/// list and a customer reads on a tracking page. Everything else is an exit:
/// held for a human, refused, sent back, or lost.
enum OrderWorkflowState {
  /// Placed, not yet screened. Transient — the screening runs immediately after
  /// checkout — but it is a real state because screening can be slow or the
  /// fraud provider can be down.
  PENDING
  /// Screening said no, or said "not sure". A human has to release or refuse it
  /// before anything else happens. Nothing auto-dispatches out of here.
  FRAUD_REVIEW
  /// Cleared for shipping and queued for the courier. Separate from DISPATCHED
  /// because the courier call can fail and be retried without losing the fact
  /// that the order was approved.
  PROCESSING
  /// A consignment exists at the courier.
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  /// Delivered short — some units accepted, some refused at the door. Common
  /// enough in cash-on-delivery to deserve its own state rather than being
  /// rounded to DELIVERED or RETURNED.
  PARTIALLY_DELIVERED
  /// Courier is bringing it back, or has.
  RETURNED
  CANCELLED
  /// The courier could not deliver and the parcel is not yet moving back, or
  /// the dispatch itself was rejected. Needs a human either way.
  FAILED
}

enum FraudVerdict {
  /// Cleared every threshold the merchant set.
  PASS
  /// Failed at least one threshold, or the customer has no history and the
  /// merchant chose not to trust unknown numbers.
  REVIEW
  /// Confirmed fraud reports over the merchant's limit.
  FAIL
  /// The check could not be run — no credentials, provider down, network gone.
  /// Distinct from REVIEW because the customer did nothing wrong and the
  /// merchant may want to treat the two differently.
  UNAVAILABLE
}

enum FinancialStatus {
  PENDING
  AUTHORIZED
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum CancelReason {
  CUSTOMER
  FRAUD
  INVENTORY
  DECLINED
  OTHER
}

// Every descriptive field here is a snapshot taken at checkout. productId and
// variantId are nullable and SetNull on delete: the order must survive the
// product being deleted, and it still reads correctly because the title, SKU
// and price are stored inline rather than joined.
model OrderLine {
  id      String @id @default(cuid())
  orderId String

  productId String?
  variantId String?

  title        String
  variantTitle String?
  sku          String?
  vendor       String?

  quantity           Int
  unitPriceCents     Int
  totalDiscountCents Int   @default(0)
  taxTotalCents      Int   @default(0)
  taxLines           Json? // [{ title, rateBps, amountCents }]
  totalCents         Int

  requiresShipping Boolean @default(true)
  weightGrams      Int     @default(0)
  properties       Json?

  // Drives partial refunds and partial returns. `returnedQuantity` is how many
  // of this line came back — the customer refusing three of five shirts at the
  // door is the ordinary case in this market, not an exception.
  refundedQuantity Int @default(0)
  returnedQuantity Int @default(0)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  refundLines RefundLine[]
  returnLines OrderReturnLine[]

  @@index([orderId])
}

// ── Payments ─────────────────────────────────────────────────────────────

model PaymentProviderConfig {
  id             String @id @default(cuid())
  organizationId String

  provider    PaymentProvider
  displayName String
  isEnabled   Boolean         @default(false)
  testMode    Boolean         @default(true)
  position    Int             @default(0)

  // Encrypted at rest by lib/crypto.ts — never select this column into
  // anything that reaches the client.
  credentials  Json?
  // Shown to the shopper for offline methods (bank details, COD terms).
  instructions String? @db.Text

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  RAZORPAY
  SSLCOMMERZ
  BKASH
  MANUAL
  CASH_ON_DELIVERY
}

// Append-only money ledger. An order's paid/refunded totals are the sum of
// these rows; nothing else is allowed to move money.
model Transaction {
  id      String @id @default(cuid())
  orderId String

  kind         TransactionKind
  status       TransactionStatus @default(PENDING)
  provider     PaymentProvider
  amountCents  Int
  currencyCode String

  gatewayReference String? // provider-side id, for reconciliation
  errorCode        String?
  errorMessage     String?
  // Raw provider payload, kept for disputes. May contain PII.
  gatewayResponse  Json?

  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([gatewayReference])
}

enum TransactionKind {
  AUTHORIZATION
  CAPTURE
  SALE
  REFUND
  VOID
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILURE
  ERROR
}

// ── Fulfillment & refunds ────────────────────────────────────────────────

/// A recorded return, whole or partial.
///
/// Separate from Refund on purpose. A refund is money going back to a customer;
/// a return in a cash-on-delivery market usually involves no money at all — the
/// parcel was refused at the door, nothing was ever collected, and what changes
/// is what the customer owes and what is back on the shelf. Filing those as
/// refunds would report money as moving that never did, and every revenue
/// figure downstream would inherit the lie.
///
/// Appended, never edited: the order's totals are recomputed from the sum of
/// its returns, so a correction is another row rather than a rewrite of this one.
model OrderReturn {
  id      String @id @default(cuid())
  orderId String

  /// What this return took off what the customer owes.
  refundAmountCents    Int     @default(0)
  /// Whether delivery was waived as part of this return specifically.
  deliveryChargeWaived Boolean @default(false)
  /// Whether the goods went back on the shelf. A damaged return comes back as a
  /// return but must not become sellable stock.
  restocked            Boolean @default(true)
  note                 String?

  /// Who recorded it. Kept as a snapshot name too, because the staff account may
  /// be removed long before the order stops being disputed.
  actorUserId String?
  actorName   String?

  createdAt DateTime @default(now())

  order Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines OrderReturnLine[]

  @@index([orderId])
}

model OrderReturnLine {
  id            String @id @default(cuid())
  orderReturnId String
  orderLineId   String
  quantity      Int

  orderReturn OrderReturn @relation(fields: [orderReturnId], references: [id], onDelete: Cascade)
  orderLine   OrderLine   @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([orderReturnId])
}

model Refund {
  id      String @id @default(cuid())
  orderId String

  amountCents   Int
  shippingCents Int     @default(0)
  taxCents      Int     @default(0)
  reason        String?
  note          String?
  restock       Boolean @default(true)
  actorUserId   String?

  createdAt DateTime @default(now())

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines RefundLine[]

  @@index([orderId])
}

model RefundLine {
  id          String @id @default(cuid())
  refundId    String
  orderLineId String
  quantity    Int
  amountCents Int

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([refundId])
}

// Human-readable order timeline ("payment captured", "note added"). Distinct
// from AuditLog, which is platform-operator facing: these events are shown to
// the merchant in the order detail view.
model OrderEvent {
  id      String @id @default(cuid())
  orderId String

  type        String
  message     String
  metadata    Json?
  actorUserId String?
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ── Discounts ────────────────────────────────────────────────────────────

// One Discount (the rule) can have several DiscountCodes (the strings shoppers
// type), which is how a single campaign runs per-influencer codes.
model Discount {
  id             String @id @default(cuid())
  organizationId String

  title  String
  method DiscountMethod @default(CODE)
  type   DiscountType

  // PERCENTAGE reads valueBps (basis points); FIXED_AMOUNT and the BXGY
  // reward read valueCents. FREE_SHIPPING reads neither.
  valueBps   Int?
  valueCents Int?

  appliesTo           DiscountScope @default(ALL)
  targetProductIds    String[]      @default([])
  targetCollectionIds String[]      @default([])

  // Entry conditions.
  minimumSubtotalCents Int?
  minimumQuantity      Int?

  // Buy X Get Y.
  buyQuantity Int?
  getQuantity Int?

  // Usage limits. `usageCount` is incremented inside the checkout transaction
  // so a limited code cannot be redeemed past its cap by concurrent checkouts.
  usageLimit        Int?
  usageCount        Int     @default(0)
  oncePerCustomer   Boolean @default(false)
  combinesWithOther Boolean @default(false)

  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  codes        DiscountCode[]

  @@index([organizationId, isActive])
}

enum DiscountMethod {
  CODE
  AUTOMATIC
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum DiscountScope {
  ALL
  PRODUCTS
  COLLECTIONS
}

model DiscountCode {
  id         String @id @default(cuid())
  discountId String
  code       String
  usageCount Int    @default(0)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([discountId, code])
  @@index([code])
}

// ── Shipping & tax ───────────────────────────────────────────────────────

model ShippingZone {
  id             String @id @default(cuid())
  organizationId String

  name         String
  countryCodes String[] @default([]) // empty = rest of world
  createdAt    DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rates        ShippingRate[]

  @@index([organizationId])
}

// A rate applies when the cart falls inside BOTH its price band and its weight
// band (null bound = open-ended). Rates are evaluated cheapest-first.
model ShippingRate {
  id     String @id @default(cuid())
  zoneId String

  name        String
  priceCents  Int
  description String?

  minSubtotalCents Int?
  maxSubtotalCents Int?
  minWeightGrams   Int?
  maxWeightGrams   Int?

  position Int @default(0)

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, position])
}

model TaxRate {
  id             String @id @default(cuid())
  organizationId String

  name              String
  countryCode       String
  provinceCode      String?
  rateBps           Int // basis points: 8.25% = 825
  appliesToShipping Boolean @default(false)
  // When set, only variants carrying this tax code use the rate.
  taxCode           String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, countryCode, provinceCode, taxCode])
  @@index([organizationId])
}

// ── Integration: API keys ────────────────────────────────────────────────

// A machine credential for the public REST API.
//
// Only the SHA-256 of the token is stored. The plaintext is shown once, at
// creation, and is unrecoverable afterwards — which is the point: a leaked
// database, backup or read replica yields hashes that cannot be replayed
// against the API. Losing a key therefore means rotating it, not looking it up.
//
// SHA-256 rather than bcrypt/argon2 deliberately. Those exist to slow down
// guessing of *low-entropy human passwords*; this token is 32 random bytes, so
// brute force is already infeasible, and a slow KDF would only add tens of
// milliseconds to every authenticated API request.
model ApiKey {
  id             String @id @default(cuid())
  organizationId String

  name String

  // The public half, e.g. "ncom_live_7f3a9c21". Shown in the UI and logged, so
  // a merchant can tell which key is which without ever seeing the secret.
  prefix String @unique

  // sha256(prefix + '.' + secret), hex. Unique so authentication is a single
  // indexed lookup rather than a scan-and-compare over every key.
  tokenHash String @unique

  // Last four characters of the secret, for "…a91c" in the key list. Four
  // characters of a 43-character token is not enough to narrow a guess.
  last4 String

  scopes ApiScope[] @default([])

  lastUsedAt      DateTime?
  lastUsedIp      String?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdByUserId String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// What a key is allowed to do. Read and write are separate per resource so an
// import script and a stock-sync daemon do not both have to be able to delete
// the catalogue.
enum ApiScope {
  PRODUCTS_READ
  PRODUCTS_WRITE
  CATEGORIES_READ
  CATEGORIES_WRITE
  INVENTORY_READ
  INVENTORY_WRITE
  ORDERS_READ
  ORDERS_WRITE
  WEBHOOKS_READ
  WEBHOOKS_WRITE
}

// ── Integration: outbound webhooks ───────────────────────────────────────

// Where this organisation wants change notifications delivered.
//
// The secret is stored encrypted rather than hashed, because unlike an API key
// it has to be *used* on every send: the delivery is signed with it so the
// receiver can prove the request came from us and not from anyone who learned
// the URL. See lib/crypto.ts for the envelope.
model WebhookEndpoint {
  id             String @id @default(cuid())
  organizationId String

  url         String
  description String?
  topics      WebhookTopic[] @default([])

  /// Encrypted at rest. Signing key for the X-NCOM-Signature header.
  secret String

  isActive Boolean @default(true)

  // Auto-disable bookkeeping. An endpoint that has been dead for days is a
  // queue that grows forever and a retry budget spent on nothing, so the
  // service parks it and tells the merchant rather than retrying indefinitely.
  consecutiveFailures Int       @default(0)
  disabledAt          DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastErrorMessage    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
}

// One attempt-tracked delivery of one event to one endpoint.
//
// Persisted before the HTTP call, not after: a delivery that is never recorded
// cannot be retried, and "did you send it?" is the first question in every
// integration support thread. The row is the queue as well as the log.
model WebhookDelivery {
  id        String @id @default(cuid())
  webhookId String

  topic WebhookTopic

  // Stable per business event, shared by every endpoint that receives it and by
  // every retry of it. Receivers use it to deduplicate, which is what makes
  // at-least-once delivery safe to build on.
  eventId String

  payload Json

  status       WebhookDeliveryStatus @default(PENDING)
  attempts     Int                   @default(0)
  statusCode   Int?
  error        String?
  responseBody String?               @db.Text

  nextAttemptAt DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  webhook WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  // Drives the retry sweep: pending rows whose backoff has elapsed.
  @@index([status, nextAttemptAt])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// What happened. Named `resource.verb` to match the JSON `topic` field the
// receiver reads, so the enum, the docs and the wire format never drift.
enum WebhookTopic {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  INVENTORY_UPDATED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_CANCELLED
  ORDER_FULFILLED
  ORDER_HELD_FOR_REVIEW
  SHIPMENT_CREATED
  SHIPMENT_UPDATED
  SHIPMENT_DELIVERED
  SHIPMENT_RETURNED
}

// ── Courier automation ───────────────────────────────────────────────────
//
// Cash-on-delivery is the default in the markets this platform serves, which
// makes a delivery attempt a loan: the merchant ships goods and pays the
// courier's fee before anyone has paid them. A customer with a habit of
// refusing parcels at the door costs real money every time, so orders are
// screened against the courier's own delivery history for that phone number
// before anything is handed over.
//
// The pipeline: order placed -> phone screened -> either auto-dispatched to the
// courier or held for a human -> consignment created -> the courier's webhooks
// drive every state after that, with a reconciliation poll behind them because
// a webhook that is missed once is missed forever.

enum CourierProvider {
  STEADFAST
  PATHAO
}

// Per-organisation courier account.
//
// Credentials are per tenant, never platform-wide: the merchant ships on their
// own courier contract, the COD money settles into their account, and the fraud
// history they screen against is the one their own account can see.
model CourierConfig {
  id             String @id @default(cuid())
  organizationId String

  provider    CourierProvider
  displayName String
  isEnabled   Boolean         @default(false)
  /// Pathao's sandbox. Steadfast has no test environment, so this only gates
  /// which base URL Pathao calls.
  testMode    Boolean         @default(false)
  /// Which courier gets an order when the merchant does not name one.
  isDefault   Boolean         @default(false)
  position    Int             @default(0)

  /// Encrypted at rest by lib/crypto.ts, value by value. Never select this
  /// column into anything that reaches the client.
  ///
  /// Steadfast: apiKey, secretKey — the portal API pair that creates parcels.
  /// Pathao: clientId, clientSecret, username, password.
  ///
  /// Fraud screening credentials are deliberately NOT here. They are a
  /// different account type entirely — merchant portal logins rather than API
  /// keys — and a merchant needs several of them, because the portal rate
  /// limits and locks accounts and one dead login must not stop screening. See
  /// FraudAccount.
  credentials Json?

  /// Non-secret operating parameters — Pathao store_id, delivery_type,
  /// item_type, default parcel weight. Plain JSON because none of it is a
  /// secret and the merchant edits it directly.
  settings Json?

  /// Pathao's OAuth token, cached across restarts so a cold start does not
  /// re-authenticate on the buyer's critical path. Encrypted: it is a bearer
  /// credential with five days of life.
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?

  /// The unguessable path segment in this config's inbound webhook URL. The
  /// couriers cannot send a tenant id, so the URL itself is what identifies
  /// which organisation an incoming status update belongs to — and a guessable
  /// URL would let anyone drive another merchant's orders to "delivered".
  webhookToken String @unique

  /// Encrypted. What the courier must present on an inbound call: Pathao's
  /// X-PATHAO-Signature, or the bearer token Steadfast is configured with.
  webhookSecret String?

  /// Last successful credential test, and why the last one failed. Shown in the
  /// settings UI so "it stopped working" has an answer before support is called.
  lastVerifiedAt   DateTime?
  lastErrorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipments    CourierShipment[]

  @@unique([organizationId, provider])
  @@index([organizationId])
}

// The merchant's rules for letting an order through without a human.
//
// One row per organisation. Thresholds are stored as integers — basis points
// for the rate, counts for the rest — so the comparison that decides whether to
// ship goods is exact rather than a float that lands on 69.99999%.
model CourierSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  /// Master switch. Off means every order waits for a human, which is where a
  /// merchant starts before they trust the thresholds.
  autoDispatchEnabled Boolean @default(false)
  /// Screen phone numbers at all. Independent of auto-dispatch: a merchant may
  /// want the verdict shown on every order while still dispatching by hand.
  fraudCheckEnabled   Boolean @default(true)

  /// Minimum parcels in this customer's courier history at all, delivered or
  /// refused. A number nobody has ever shipped to tells you nothing, whatever
  /// its rate reads.
  minTotalParcels    Int  @default(10)
  /// Minimum parcels actually delivered. Separate from the total above, because
  /// 20 parcels of which 2 arrived is plenty of history and a terrible
  /// customer.
  minDeliveredOrders Int  @default(10)
  /// Minimum share of this customer's parcels that were delivered, in basis
  /// points (7000 = 70%). Zero switches the rate check off and leaves the two
  /// count rules to decide, which is how most merchants start.
  minDeliveryRateBps Int  @default(0)
  /// Confirmed fraud reports tolerated. Zero for most merchants.
  maxFraudReports    Int  @default(0)
  /// Cancelled parcels tolerated in absolute terms, on top of the rate — a
  /// customer with 40 delivered and 15 refused passes a 70% rate but is still
  /// costing money. Null disables the check.
  maxCancelledOrders Int?

  /// What to do with a phone number the courier has never seen. Most first-time
  /// customers are simply new, so the default trusts them; a merchant burned by
  /// throwaway numbers turns this off and reviews them by hand.
  allowUnknownCustomers Boolean @default(true)

  /// Orders over this value always get a human look, however clean the history.
  /// Null means value is not considered.
  manualReviewAboveCents Int?

  /// Hold auto-dispatch for this long after checkout, so a customer who
  /// immediately calls to change an address or cancel is not chasing a parcel
  /// that already left. Zero dispatches at once.
  dispatchDelayMinutes Int @default(0)

  /// Only dispatch orders that are already paid. Off by default because the
  /// whole point of this pipeline is cash on delivery.
  requirePaidOrders Boolean @default(false)

  /// How long a phone lookup stays good. The courier's own numbers move slowly
  /// and every lookup is a login to their portal, so re-checking per order
  /// would be both slow and rude.
  fraudCacheHours Int @default(24)

  /// Automatically cancel anything the screen returns FAIL for, instead of
  /// queueing it. Off by default: a wrong auto-cancel loses a real sale, and
  /// the merchant should see the first few before delegating that.
  autoCancelOnFail Boolean @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// One parcel at one courier.
//
// Not folded into Fulfillment: a Fulfillment records that stock left the
// building and which units, while this records a live conversation with a third
// party that keeps changing its mind for a week afterwards. Both exist for the
// same order, and fulfilling is what creates this.
model CourierShipment {
  id              String  @id @default(cuid())
  organizationId  String
  orderId         String
  courierConfigId String?

  provider CourierProvider

  /// The courier's identifier for the parcel. Nullable until the create call
  /// comes back — the row is written first so a failed dispatch is visible and
  /// retryable rather than lost.
  consignmentId   String?
  /// Steadfast's short code, and what a customer is given to track with.
  trackingCode    String?
  /// What we sent as the courier's `invoice` / `merchant_order_id`. This is how
  /// a webhook that omits the consignment id still finds its way home.
  merchantOrderId String

  status        CourierShipmentStatus @default(PENDING)
  /// The courier's own status string, unmapped. Kept because their vocabulary
  /// changes without notice and a status we have not mapped yet must still be
  /// readable by a human looking at the row.
  rawStatus     String?
  statusMessage String?

  /// What the courier was asked to collect, and what they say they collected.
  /// The difference is the merchant's problem to chase, so both are recorded.
  codAmountCents       Int
  collectedAmountCents Int?
  deliveryFeeCents     Int?

  recipientName    String
  recipientPhone   String
  recipientAddress String

  /// Exactly what was sent and exactly what came back, for the argument that
  /// starts when a parcel goes missing. May contain PII.
  requestPayload  Json?
  responsePayload Json?

  /// Dispatch bookkeeping. A courier API that is down must not strand an order:
  /// the attempt is counted, the error kept, and the sweep tries again.
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime?

  dispatchedAt DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  /// Last time the courier told us anything, by webhook or by poll. The
  /// reconciliation sweep uses this to find parcels that have gone quiet.
  lastEventAt  DateTime?
  lastPolledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  config       CourierConfig?         @relation(fields: [courierConfigId], references: [id], onDelete: SetNull)
  events       CourierShipmentEvent[]

  // A consignment id is unique within a courier, and this is what makes an
  // inbound webhook idempotent: the same update arriving twice finds the same
  // row. Null until the courier assigns one, and Postgres treats nulls as
  // distinct, so undispatched rows do not collide.
  @@unique([provider, consignmentId])
  @@index([organizationId, status])
  @@index([orderId])
  @@index([trackingCode])
  // Drives both the dispatch retry and the reconciliation poll.
  @@index([status, nextAttemptAt])
  @@index([status, lastPolledAt])
}

// Canonical parcel states, mapped from each courier's own vocabulary in
// server/courier/statusMap.ts.
//
// Deliberately smaller than the union of what the couriers report: a merchant
// tracking parcels across two providers needs one ladder, not two. The
// provider's exact wording is preserved on `rawStatus` for anyone who needs it.
enum CourierShipmentStatus {
  /// Row exists, courier has not been called yet or the call failed.
  PENDING
  /// Courier accepted the consignment and is reviewing it.
  SUBMITTED
  PICKUP_PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIALLY_DELIVERED
  ON_HOLD
  RETURN_IN_TRANSIT
  RETURNED
  CANCELLED
  DELIVERY_FAILED
  /// The courier reported something we do not map. Surfaced rather than hidden,
  /// because silently treating an unknown status as "still in transit" is how a
  /// returned parcel goes unnoticed for a fortnight.
  UNKNOWN
}

// Append-only parcel timeline. This is what both the merchant's order page and
// the customer's tracking page read.
model CourierShipmentEvent {
  id         String @id @default(cuid())
  shipmentId String

  status  CourierShipmentStatus
  message String
  source  CourierEventSource    @default(WEBHOOK)

  /// The provider's untouched payload. Kept so a mapping bug can be diagnosed
  /// from stored data rather than by waiting for the parcel to move again.
  rawEvent Json?

  /// When the courier says it happened, which is not when we heard about it —
  /// a retried webhook can arrive hours late and must not reorder the timeline.
  occurredAt DateTime
  createdAt  DateTime @default(now())

  shipment CourierShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

enum CourierEventSource {
  /// Pushed by the courier.
  WEBHOOK
  /// Found by the reconciliation poll, because the push was missed.
  POLL
  /// Written by this platform — dispatched, retried, cancelled by a merchant.
  SYSTEM
}

// A Steadfast merchant portal login used to read customer delivery history.
//
// Separate from CourierConfig, and deliberately plural, because these are a
// different kind of credential doing a different job. CourierConfig holds one
// API key pair that creates parcels; this holds the portal logins that *read*
// other merchants' delivery outcomes for a phone number. A merchant keeps
// several: the portal rate limits, locks accounts, and expires sessions, and a
// screen that stops working because one login went bad is a screen that quietly
// stops protecting the store. Lookups try each account in turn.
model FraudAccount {
  id             String @id @default(cuid())
  organizationId String

  email    String
  /// Encrypted at rest by lib/crypto.ts. Unlike an API key this must be
  /// replayable — every login to the portal re-sends it — so it is encrypted
  /// rather than hashed.
  password String
  /// Merchant's own note: "main account", "backup — Rakib's".
  label    String?

  isActive Boolean @default(true)
  /// Order accounts are tried in. The first working one answers.
  position Int     @default(0)

  /// Per-account health, recorded by testing each login individually rather
  /// than inferring it from whether *some* account worked. One working account
  /// masking three dead ones is exactly how a merchant discovers the problem
  /// only when the last one dies.
  lastTestedAt    DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  /// When this account last answered a real lookup, for spotting one that tests
  /// fine but is never actually reached.
  lastUsedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId, position])
}

// Cached delivery history for a phone number.
//
// Cached per organisation rather than platform-wide on purpose. The numbers
// come from the merchant's own courier account and reflect what *that* account
// can see; sharing them across tenants would leak one merchant's customer
// history to another and would be wrong as often as it was useful.
model CourierFraudCheck {
  id             String @id @default(cuid())
  organizationId String

  /// Normalised to local 11-digit form (01XXXXXXXXX) before storage, so
  /// +8801X, 8801X and 01X are one customer rather than three.
  phone    String
  provider CourierProvider @default(STEADFAST)

  totalOrders    Int
  delivered      Int
  cancelled      Int
  frauds         Int
  successRateBps Int

  /// Raw consignment list from the provider, for the merchant who wants to see
  /// the actual orders behind the numbers.
  raw Json?

  checkedAt DateTime @default(now())
  /// When this lookup goes stale. Read directly rather than computed from
  /// checkedAt, so shortening the cache window in settings takes effect on the
  /// next check instead of retroactively expiring everything at once.
  expiresAt DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phone])
  @@index([organizationId, checkedAt])
}
