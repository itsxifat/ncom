# Database
DATABASE_URL="postgresql://ncom:ncom@localhost:5432/ncom"

# Auth.js
AUTH_SECRET="" # generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Multi-tenant subdomain routing
# In local dev, "*.localhost:3000" resolves natively - no /etc/hosts editing needed.
ROOT_DOMAIN="localhost:3000"

# Object storage (S3-compatible: AWS S3, Cloudflare R2, or local MinIO from docker-compose.yml)
STORAGE_DRIVER="local" # "s3" | "local"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ncom-media"
S3_ACCESS_KEY_ID="ncom_minio"
S3_SECRET_ACCESS_KEY="ncom_minio_secret"
S3_PUBLIC_URL="http://localhost:9000/ncom-media"

# Redis (rate limiting, subdomain resolution cache, published-page render cache)
REDIS_URL="redis://localhost:6379"
