# Database
DATABASE_URL="postgresql://ncom:ncom@localhost:5432/ncom"

# Auth.js
AUTH_SECRET="" # generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# There is no seeded administrator. The first account to register claims the
# SUPER_ADMIN role, once, and that claim is latched permanently (deleting the
# admin does not re-open it).
#
# SET THIS ON ANY DEPLOYMENT REACHABLE FROM THE INTERNET. It restricts the claim
# to one address, closing the window between deploying a fresh instance and
# registering — without it, whoever signs up first becomes the administrator.
# Leave empty for local development.
ADMIN_BOOTSTRAP_EMAIL=""

# Google sign-in. Optional: with these unset the provider is not registered at
# all and the "Continue with Google" button is hidden (the admin flag
# auth.googleLoginEnabled controls whether it is offered when they ARE set).
# Authorised redirect URI: ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Multi-tenant subdomain routing
# In local dev, "*.localhost:3000" resolves natively - no /etc/hosts editing needed.
ROOT_DOMAIN="localhost:3000"

# Any host that is neither ROOT_DOMAIN nor a tenant subdomain is treated as a
# tenant's custom domain and routed to their site. List every other hostname the
# platform itself answers on (preview deployments, health-check hosts) here,
# comma separated, or their dashboard requests will be rewritten to a storefront
# lookup and 404. ROOT_DOMAIN, AUTH_URL and localhost are always included.
PLATFORM_HOSTS=""

# Ingress IP that tenants point an apex A record at. Apex domains cannot hold a
# CNAME, so without this the domain UI tells those tenants to use their
# provider's ALIAS/ANAME record instead. Subdomains always use a CNAME to
# sites.${ROOT_DOMAIN}.
DOMAIN_TARGET_IP=""

# Media storage (EnCDN) - credentials come from the EnCDN admin panel under
# Clients > View credentials. The key and secret are server-side only.
CDN_BASE_URL="https://cdn.enfinito.cloud"
CDN_API_KEY=""    # starts with cdn_
CDN_API_SECRET="" # 64 hex characters

# Store lifetime signed delivery URLs (default). Signed URLs bypass EnCDN's
# domain locking, so tenant sites work on any subdomain or custom domain.
# Set to "false" only if the EnCDN client is in "public" access mode.
CDN_SIGNED_URLS="true"
# Read from the upload response automatically; set only to override.
# CDN_CLIENT_ID=""

# Redis (rate limiting, subdomain resolution cache, published-page render cache)
REDIS_URL="redis://localhost:6379"

# Shared secret for the scheduled usage-alert sweep (/api/cron/usage-alerts).
# The route refuses every request while this is unset. Generate with:
#   openssl rand -hex 32
CRON_SECRET=""
