# Database
DATABASE_URL="postgresql://ncom:ncom@localhost:5432/ncom"

# Auth.js
AUTH_SECRET="" # generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# There is no seeded administrator. The first account to register claims the
# SUPER_ADMIN role, once, and that claim is latched permanently (deleting the
# admin does not re-open it).
#
# SET THIS ON ANY DEPLOYMENT REACHABLE FROM THE INTERNET. It restricts the claim
# to one address, closing the window between deploying a fresh instance and
# registering — without it, whoever signs up first becomes the administrator.
# Leave empty for local development.
ADMIN_BOOTSTRAP_EMAIL=""

# Google sign-in. Optional: with these unset the provider is not registered at
# all and the "Continue with Google" button is hidden (the admin flag
# auth.googleLoginEnabled controls whether it is offered when they ARE set).
# Authorised redirect URI: ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Multi-tenant subdomain routing
# In local dev, "*.localhost:3000" resolves natively - no /etc/hosts editing needed.
ROOT_DOMAIN="localhost:3000"

# Any host that is neither ROOT_DOMAIN nor a tenant subdomain is treated as a
# tenant's custom domain and routed to their site. List every other hostname the
# platform itself answers on (preview deployments, health-check hosts) here,
# comma separated, or their dashboard requests will be rewritten to a storefront
# lookup and 404. ROOT_DOMAIN, AUTH_URL and localhost are always included.
PLATFORM_HOSTS=""

# Ingress IP that tenants point an apex A record at. Apex domains cannot hold a
# CNAME, so without this the domain UI tells those tenants to use their
# provider's ALIAS/ANAME record instead. Subdomains always use a CNAME to
# sites.${ROOT_DOMAIN}.
DOMAIN_TARGET_IP=""

# Media storage (EnCDN) - credentials come from the EnCDN admin panel under
# Clients > View credentials. The key and secret are server-side only.
CDN_BASE_URL="https://cdn.enfinito.cloud"
CDN_API_KEY=""    # starts with cdn_
CDN_API_SECRET="" # 64 hex characters

# Store lifetime signed delivery URLs (default). Signed URLs bypass EnCDN's
# domain locking, so tenant sites work on any subdomain or custom domain.
# Set to "false" only if the EnCDN client is in "public" access mode.
CDN_SIGNED_URLS="true"
# Read from the upload response automatically; set only to override.
# CDN_CLIENT_ID=""

# Redis (rate limiting, subdomain resolution cache, published-page render cache)
REDIS_URL="redis://localhost:6379"

# Shared secret for the scheduled sweeps. Every /api/cron/* route refuses all
# requests while this is unset. Generate with:
#   openssl rand -hex 32
#
#   * * * * *     /api/cron/webhook-retries   retry failed outbound webhooks
#   * * * * *     /api/cron/tracking-retries  retry failed Meta/GA4 conversions
#   */5 * * * *   /api/cron/courier-sync      dispatch due parcels, poll quiet ones
#   0 * * * *     /api/cron/usage-alerts      plan usage warnings
#
# tracking-retries matters to anyone running ads: a conversion whose first send
# failed — Meta rate-limiting a campaign launch is the ordinary cause — is only
# ever retried by this sweep, and the whole retry schedule expires after about
# 40 minutes because both platforms reject events that arrive too late.
#
# courier-sync is not optional if you use courier automation: it is what sends
# orders held behind a dispatch delay, retries dispatches a courier refused
# transiently, and notices parcels whose status webhook was dropped. A dropped
# webhook is silent — nothing fails and nothing logs, the parcel simply stops
# updating — so polling is the only thing that catches it.
CRON_SECRET=""

# Courier credentials are NOT set here. Each merchant connects their own
# Steadfast and Pathao accounts under Setup > Courier & fraud, and the values
# are encrypted per organisation with AUTH_SECRET before they are stored — one
# tenant's courier contract must never ship another tenant's parcels.
#
# Note for Steadfast: the API key/secret pair (which creates parcels) and the
# merchant portal logins (which read customer delivery history for fraud
# screening) are different credentials doing different jobs. Both are entered in
# the dashboard; without the second, parcels ship but customers are not screened.
#
# Screening takes SEVERAL portal logins, not one. The portal rate limits, locks
# accounts and expires sessions, so a store running on a single login has a
# screen that stops working without announcing it. Lookups try each account in
# turn, and each account's health is tested on its own — one working login
# otherwise hides three dead ones until the last one goes.
#
# FRAUDJS_CREDENTIALS / FRAUDJS_SECRET from the steadfast-fraud package are NOT
# used and must not be set: those are one credential set per process, which is
# wrong for a platform where each merchant screens under their own accounts.
# Only the package's session/login handling is used; the credentials come from
# the database, encrypted per organisation.
