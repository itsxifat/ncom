{
  "name": "ncom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "icons": "node scripts/generate-app-icons.mjs",
    "prepare": "husky",
    "postinstall": "prisma generate",
