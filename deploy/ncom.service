[Unit]
Description=NCOM (Next.js)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ncom
WorkingDirectory=/srv/ncom
EnvironmentFile=/srv/ncom/.env.production

# Loopback only. Caddy is the only thing that should be able to reach the app —
# binding 0.0.0.0 would expose it on :3000 with no TLS and no on-demand gate.
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=NODE_ENV=production

ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5

# A Next.js build/boot that dies mid-request should not take the box with it.
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
